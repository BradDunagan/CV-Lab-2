{
  "name": "cv-lab-2",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + native C skeleton for compute-intensive image processing",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node.js",
    "preinstall": "node scripts/check-node.js",
    "postinstall": "node scripts/brand-dev-electron.js",
    "prebuild:native": "node scripts/check-node.js",
    "prebuild:renderer": "node scripts/check-node.js",
    "pretest": "node scripts/check-node.js",
    "build:native": "node-gyp rebuild",
    "build:renderer": "vite build",
    "build:generate": "vite build --config vite.generate.config.mjs",
    "dev:renderer": "vite build --watch",
    "lint:native": "node scripts/lint-native.js",
    "rebuild:electron": "node scripts/rebuild-electron.js",
    "test:native": "node test/smoke.js && node test/buffer.js && node test/kernels.js && node test/render.js",
    "sample": "node scripts/make-sample.js 12",
    "lab": "electron scripts/lab-cli.js",
    "generate": "electron scripts/generate-cli.js",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run rebuild:electron && npm run build:renderer && electron .",
    "package": "npm run build:renderer && electron-builder --publish never",
    "verify:package": "node scripts/verify-package.js",
    "test:lab": "node test/registry.js && node test/session.js && node test/png.js && node test/corners.js",
    "test:determinism": "node test/determinism.js",
    "test:readme": "node test/readme.js",
    "test": "npm run test:native && npm run test:lab && npm run test:determinism && npm run test:readme && npm run test:renderer && npm run test:cli",
    "test:renderer": "electron test/renderer.js",
    "test:cli": "node test/cli.js"
  },
  "author": "Brad Dunagan <brad.dunagan@gmail.com>",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "node-gyp": "^13.0.1",
    "paneless": "file:../paneless-workspace/packages/paneless",
    "svelte": "^5.56.10",
    "vite": "^7.3.6"
  }
}
