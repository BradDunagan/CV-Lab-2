// The geometry pipeline, plus what the renderer says put each edge there.
//
// Run it over a directory generated WITH ground truth and AOV passes:
//
//   npm run generate -- --out generated/ --scene saved:cube-1 --truth --aovs
//   npm run lab -- --script pipelines/explained.lab --as linear \
//                  --truth generated/ --aovs generated/ --out results/ generated/*.png
//   npm run score -- results/
//
// A, T and the three passes D/NM/AL are prepended by the runner, one per
// image: a .lab script names operations rather than files.
//
// explain takes T for one number: maxDepth, the metre scale the depth pass was
// packed against. It is in the .gt.json and nowhere else -- the passes carry no
// colour chunks and therefore no metadata -- and it changes per image, so it
// could not be a parameter written into a script.

G  = gray(A)
B  = gaussian(G, sigma=1.4)
Gx = sobel(B, axis=x)
Gy = sobel(B, axis=y)
M  = sobel(B, axis=mag)
N  = nms(M, Gx, Gy)
S  = segments(N, Gx, Gy)
R  = merge(S)
F  = fit(R)
C  = corners(F)

// What the detector responded to, whether or not it matched anything.
EF = explain(F, D, NM, AL, T)
EC = explain(C, D, NM, AL, T)

// And whether it was really there.
MF = match(F, T)
MC = match(C, T)
